# ===== Google Search Console / GA4 OAuth (untuk tombol Hubungkan) =====
# Dapatkan di: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publik aplikasi (untuk callback OAuth Search Console)
APP_URL=https://razeo.vercel.app

# ===== Supabase (database + login Google) =====
# Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Dibangun ke frontend (vite), harus diawali VITE_ =====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
