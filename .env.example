# ===== Google Search Console / GA4 OAuth =====
# Dapatkan di: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publik aplikasi (untuk callback OAuth)
APP_URL=http://localhost:3000

# ===== Firebase (login Google) =====
# Stringified Firebase service account JSON (untuk verifikasi token login di server)
FIREBASE_SERVICE_ACCOUNT=

# ===== Supabase (database utama Razeo) =====
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=